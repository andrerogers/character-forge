generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id           String        @id @default(cuid())
  name         String
  description  String
  tagline      String?
  style        String
  age          String?
  personality  String[]
  backstory    String?
  colorPalette String[]
  tags         String[]      @default([])
  imagePath    String?
  // "provider:model" that made the portrait, e.g. "openrouter:google/gemini-2.5-flash-image"
  imageSource  String?
  concept      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sketches     Sketch[]
  guide        DrawingGuide?
  videos       Video[]
}

model Sketch {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  imagePath   String
  note        String?

  @@index([characterId])
}

model DrawingGuide {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  characterId      String        @unique
  character        Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  proportionSystem String?
  overlayImagePath String?
  steps            DrawingStep[]
}

model DrawingStep {
  id           String       @id @default(cuid())
  stepNumber   Int
  title        String
  instructions String
  imagePath    String
  guideId      String
  guide        DrawingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, stepNumber])
}

model Video {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  characterId      String
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  provider         String // "openrouter" | "higgsfield"
  model            String
  mode             String // "text" (text-to-video) | "image" (animate the portrait)
  prompt           String
  durationSeconds  Int
  sound            Boolean   @default(false)
  status           String // "pending" | "saving" | "completed" | "failed"
  jobId            String?
  videoPath        String?
  error            String?
  estimatedCostUsd Float?
  costUsd          Float?

  @@index([characterId])
}
