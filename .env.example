# Claude (profiles, guides) — required
ANTHROPIC_API_KEY=sk-ant-...

# Image and video providers — set any of these; pickers only offer configured ones
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
# Higgsfield keys are "id:secret"
HIGGSFIELD_API_KEY=

# Optional defaults (otherwise: first configured provider, its default model)
# IMAGE_PROVIDER=openrouter            # gemini | openrouter | higgsfield
# IMAGE_MODEL=google/gemini-2.5-flash-image
# VIDEO_PROVIDER=higgsfield            # openrouter | higgsfield
# VIDEO_MODEL=seedance                 # Higgsfield: seedance | kling | pixverse; OpenRouter: any video model id

DATABASE_URL=postgresql://character_forge:character_forge@localhost:5432/character_forge
