# Copy to .env.local (npm run setup does this for you) and fill in your keys.
# Leave a key empty if you don't have it: the app only offers providers
# whose key is set.

# Claude (character profiles, drawing guides) — required
ANTHROPIC_API_KEY=

# Image and video providers — set at least one
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Higgsfield keys look like "id:secret"
HIGGSFIELD_API_KEY=

# Optional defaults (otherwise: first configured provider, its default model)
# IMAGE_PROVIDER=openrouter            # gemini | openrouter | higgsfield
# IMAGE_MODEL=google/gemini-2.5-flash-image
# VIDEO_PROVIDER=higgsfield            # openrouter | higgsfield
# VIDEO_MODEL=seedance                 # Higgsfield: seedance | kling | pixverse; OpenRouter: any video model id

# Matches docker-compose.yml. If you change DB_PORT, change the port here too.
DATABASE_URL=postgresql://character_forge:character_forge@localhost:5432/character_forge
